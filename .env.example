:root {
  --bg: #f7faf9;
  --primary: #0f6f52;
  --primary-dark: #0b4d3e;
  --accent: #f2b84b;
  --card: #ffffff;
  --text: #1e2b28;
  --muted: #5d6d69;
  --border: #dfe9e5;
  --bot: #edf7f3;
  --user: #0f6f52;
  --shadow: 0 20px 40px rgba(14, 42, 33, 0.12);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: var(--bg);
  color: var(--text);
}

img {
  max-width: 100%;
}

.container {
  width: min(1120px, calc(100% - 32px));
  margin: 0 auto;
}

.topbar {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 50;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72px;
}

.brand {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--primary-dark);
}

nav {
  display: flex;
  gap: 24px;
}

nav a {
  text-decoration: none;
  color: var(--text);
  font-weight: 600;
}

.hero {
  background: linear-gradient(135deg, #edf9f4 0%, #f7f6ea 100%);
  padding: 80px 0 40px;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 32px;
}

.eyebrow {
  display: inline-block;
  background: rgba(15, 111, 82, 0.1);
  color: var(--primary);
  font-weight: 700;
  border-radius: 999px;
  padding: 8px 14px;
  margin-bottom: 18px;
}

h1 {
  font-size: clamp(2.5rem, 4vw, 4rem);
  line-height: 1.05;
  margin: 0 0 18px;
  color: var(--primary-dark);
}

.hero-copy p {
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--muted);
  max-width: 600px;
}

.cta-row {
  display: flex;
  gap: 16px;
  margin-top: 28px;
  flex-wrap: wrap;
}

button,
input,
select {
  font: inherit;
}

.primary-btn,
.secondary-btn,
.chat-form button,
.widget-send {
  border: 0;
  border-radius: 12px;
  padding: 12px 20px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.primary-btn,
.chat-form button,
.widget-send {
  background: var(--primary);
  color: white;
}

.secondary-btn {
  background: white;
  color: var(--primary-dark);
  border: 1px solid var(--border);
}

.primary-btn:hover,
.secondary-btn:hover,
.chat-form button:hover,
.widget-send:hover {
  transform: translateY(-1px);
}

.hero-panel {
  display: flex;
  justify-content: center;
}

.chat-shell {
  width: min(100%, 440px);
  background: white;
  border: 1px solid var(--border);
  border-radius: 20px;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.chat-header {
  padding: 16px 18px;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.chat-header small {
  display: block;
  opacity: 0.85;
}

.chat-messages,
.widget-body {
  padding: 18px;
  min-height: 240px;
  max-height: 340px;
  overflow-y: auto;
  background: #f9fbfa;
}

.message,
.widget-message {
  margin-bottom: 12px;
  padding: 12px 14px;
  border-radius: 14px;
  line-height: 1.5;
  max-width: 90%;
}

.message.bot,
.widget-message.bot {
  background: var(--bot);
  color: var(--text);
  border-bottom-left-radius: 4px;
}

.message.user,
.widget-message.user {
  background: var(--user);
  color: white;
  margin-left: auto;
  border-bottom-right-radius: 4px;
}

.chat-form,
.widget-input-row {
  display: flex;
  gap: 8px;
  padding: 14px;
  border-top: 1px solid var(--border);
  background: white;
}

.chat-form input,
.widget-input {
  flex: 1;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px 14px;
}

.features {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
  padding: 48px 0 72px;
}

.feature-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 10px 20px rgba(13, 38, 31, 0.04);
}

.feature-card h3 {
  margin-top: 0;
  color: var(--primary-dark);
}

.lead-section {
  padding-bottom: 72px;
}

.hidden {
  display: none;
}

.lead-box {
  background: white;
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 32px;
  box-shadow: var(--shadow);
}

.form-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 18px;
}

.lead-box input,
.lead-box select {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 10px;
}

.solar-chat-widget {
  background: white;
  border: 1px solid var(--border);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: var(--shadow);
  max-width: 420px;
}

.widget-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  padding: 14px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.widget-header span {
  font-size: 0.8rem;
  opacity: 0.9;
}

.widget-body {
  max-height: 250px;
  min-height: 180px;
}

.widget-input-row {
  border-top: 1px solid var(--border);
  align-items: center;
}

.widget-send {
  min-width: 90px;
}

@media (max-width: 820px) {
  .hero-inner,
  .features,
  .form-row {
    grid-template-columns: 1fr;
  }

  nav {
    display: none;
  }
}
