:root {
  --bg: #f7faf9;
  --primary: #0f6f52;
  --primary-dark: #0b4d3e;
  --accent: #f2b84b;
  --card: #ffffff;
  --text: #1e2b28;
  --muted: #5d6d69;
  --border: #dfe9e5;
  --bot: #edf7f3;
  --user: #0f6f52;
  --shadow: 0 20px 40px rgba(14, 42, 33, 0.12);
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
}

button, input, select {
  font: inherit;
}

.container {
  width: min(1120px, calc(100% - 32px));
  margin: 0 auto;
}

.topbar {
  background: rgba(255,255,255,0.8);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 50;
}

.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 72px;
}

.brand {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--primary-dark);
}

nav {
  display: flex;
  gap: 24px;
}

nav a {
  text-decoration: none;
  color: var(--text);
  font-weight: 600;
}

.hero {
  background: linear-gradient(135deg, #edf9f4 0%, #f7f6ea 100%);
  padding: 80px 0 40px;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 32px;
}

.eyebrow {
  display: inline-block;
  background: rgba(15, 111, 82, 0.1);
  color: var(--primary);
  font-weight: 700;
  border-radius: 999px;
  padding: 8px 14px;
  margin-bottom: 18px;
}

h1 {
  font-size: clamp(2.5rem, 4vw, 4rem);
  line-height: 1.05;
  margin: 0 0 18px;
  color: var(--primary-dark);
}

.hero-copy p {
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--muted);
  max-width: 600px;
}

.cta-row {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: 28px;
}

.primary-btn, .secondary-btn, .chat-form button, .widget-send {
  border: 0;
  border-radius: 12px;
  padding: 12px 20px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.primary-btn, .chat-form button, .widget-send {
  background: var(--primary);
  color: white;
}

.secondary-btn {
  background: white;
  color: var(--primary-dark);
  border: 1px solid var(--border);
}

.primary-btn:hover, .secondary-btn:hover, .chat-form button:hover, .widget-send:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 16px rgba(15, 111, 82, 0.18);
}

.chat-shell {
  width: min(100%, 440px);
  background: white;
  border: 1px solid var(--border);
  border-radius: 20px;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.chat-header {
  padding: 16px 18px;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
}

.chat-header small {
  display: block;
  opacity: 0.9;
}

.chat-messages, .widget-body {
  padding: 18px;
  min-height: 240px;
  max-height: 340px;
  overflow-y: auto;
  background: #f9fbfa;
}

.message, .widget-message {
  margin-bottom: 12px;
  padding: 12px 14px;
  border-radius: 14px;
  line-height: 1.5;
  max-width: 90%;
  word-wrap: break-word;
}

.message.bot, .widget-message.bot {
  background: var(--bot);
  color: var(--text);
  border-bottom-left-radius: 4px;
}

.message.user, .widget-message.user {
  background: var(--user);
  color: white;
  margin-left: auto;
  border-bottom-right-radius: 4px;
}

.widget-message.loading {
  display: flex;
  gap: 4px;
  align-items: center;
}

.dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--muted);
  animation: bounce 1.4s infinite;
}

.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes bounce {
  0%, 80%, 100% { opacity: 0.4; }
  40% { opacity: 1; }
}

.chat-form, .widget-input-row {
  display: flex;
  gap: 8px;
  padding: 14px;
  border-top: 1px solid var(--border);
  background: white;
  align-items: center;
}

.chat-form input, .widget-input {
  flex: 1;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px 14px;
}

.features {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
  padding: 48px 0 72px;
}

.feature-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 24px;
  box-shadow: 0 10px 20px rgba(13,38,31,0.04);
}

.feature-card h3 {
  margin-top: 0;
  color: var(--primary-dark);
}

.tool-section {
  padding-bottom: 40px;
}

.tool-box {
  background: white;
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 28px;
  box-shadow: var(--shadow);
}

.pdf-form {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 16px;
}

.pdf-form input {
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 10px;
}

.status-box {
  margin-top: 16px;
  background: #f2f8f6;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px 14px;
  color: var(--primary-dark);
}

.lead-section {
  padding-bottom: 72px;
}

.hidden {
  display: none;
}

.lead-box {
  background: white;
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 32px;
  box-shadow: var(--shadow);
}

.form-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 18px;
}

.lead-box input, .lead-box select {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 10px;
}

.solar-chat-widget {
  background: white;
  border: 1px solid var(--border);
  border-radius: 18px;
  overflow: hidden;
  max-width: 420px;
  box-shadow: var(--shadow);
}

.widget-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  padding: 14px 16px;
}

.widget-header strong {
  display: block;
}

.widget-header small {
  font-size: 0.75rem;
  opacity: 0.9;
}

.widget-close {
  background: rgba(255,255,255,0.25);
  border: none;
  color: white;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  cursor: pointer;
}

.widget-footer {
  text-align: center;
  color: var(--muted);
  background: #f9fbfa;
  border-top: 1px solid var(--border);
  font-size: 0.75rem;
  padding: 8px 12px;
}

@media (max-width: 820px) {
  .hero-inner, .features, .form-row {
    grid-template-columns: 1fr;
  }

  nav { display: none; }

  .cta-row {
    flex-direction: column;
  }

  .cta-row button {
    width: 100%;
  }
}
